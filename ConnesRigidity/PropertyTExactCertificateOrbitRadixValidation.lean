private theorem listRangeAll_of_fin
    {count : Nat} (check : Nat → Bool)
    (checked : ∀ index : Fin count, check index.val = true) :
    (List.range count).all check = true := by
  rw [List.all_eq_true]
  intro index hindex
  exact checked ⟨index, List.mem_range.mp hindex⟩


