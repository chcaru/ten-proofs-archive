def certificateDenominator : Int := 16000000000000




def factorScale : Int := 1



def congruenceInverseScale : Int := 256


abbrev inverseScale : Int := congruenceInverseScale



noncomputable def dataEntry
    (rows : Array (Array Int)) (row column : Nat) : Int :=
  (rows.getD row #[]).getD column 0


noncomputable def coefficientOrbitTarget (orbit : Nat) : Int :=
  dataEntry coefficientTargetData orbit 0


noncomputable abbrev orbitCoefficientTarget (orbit : Nat) : Int :=
  coefficientOrbitTarget orbit


noncomputable def gramOrbitRepresentativeLeft (orbit : Nat) : Int :=
  dataEntry gramOrbitData orbit 0


noncomputable def gramOrbitRepresentativeRight (orbit : Nat) : Int :=
  dataEntry gramOrbitData orbit 1


noncomputable def gramOrbitCoefficientOrbit (orbit : Nat) : Int :=
  dataEntry gramOrbitData orbit 2


noncomputable def gramOrbitIncidence (orbit : Nat) : Int :=
  dataEntry gramOrbitData orbit 3


noncomputable def gramOrbitCoefficient (orbit : Nat) : Int :=
  dataEntry gramOrbitData orbit 4


noncomputable def gramOrbitTransportSymmetry (orbit : Nat) : Int :=
  dataEntry gramOrbitData orbit 5


noncomputable def gramOrbitInversion (orbit : Nat) : Int :=
  dataEntry gramOrbitData orbit 6


noncomputable def gramOrbitSize (orbit : Nat) : Int :=
  dataEntry gramOrbitData orbit 7


noncomputable def coefficientEquationOrbit (equation : Nat) : Int :=
  dataEntry coefficientEquationData equation 0


noncomputable def coefficientEquationStart (equation : Nat) : Int :=
  dataEntry coefficientEquationData equation 1


noncomputable def coefficientEquationCount (equation : Nat) : Int :=
  dataEntry coefficientEquationData equation 2


noncomputable def coefficientEquationTarget (equation : Nat) : Int :=
  dataEntry coefficientEquationData equation 3


noncomputable def basisOrbit (i : Nat) : Nat :=
  (dataEntry basisTransporterData i 0).toNat


noncomputable def basisTransportSymmetry (i : Nat) : Nat :=
  (dataEntry basisTransporterData i 1).toNat


noncomputable def inverseSymmetry (symmetry : Nat) : Nat :=
  (dataEntry symmetryInverseData symmetry 0).toNat


noncomputable def symmetryBasisImage (symmetry i : Nat) : Nat :=
  (dataEntry basisPermutationData symmetry i).toNat



noncomputable def normalizedPairRight (i j : Nat) : Nat :=
  symmetryBasisImage (inverseSymmetry (basisTransportSymmetry i)) j


noncomputable def pairOrbit (i j : Nat) : Nat :=
  (dataEntry pairOrbitIndexData (basisOrbit i) (normalizedPairRight i j)).toNat


noncomputable def normalizedPairOrbitWitness (i j : Nat) : Int :=
  dataEntry pairOrbitWitnessData (basisOrbit i) (normalizedPairRight i j)


noncomputable def gramEntry (i j : Nat) : Int :=
  gramOrbitCoefficient (pairOrbit i j)

