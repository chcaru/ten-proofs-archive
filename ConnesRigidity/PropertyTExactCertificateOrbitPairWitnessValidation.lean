def pairWitnessPackedPairOrbitIndex (basisOrbit second : Nat) : Nat :=
  ((pairWitnessPackedPairOrbitRows.getD basisOrbit 0) >>>
    (12 * second)) % 4096


def pairWitnessPackedPairOrbitEntriesCheck
    (packed : Nat) : List Int → Nat → Bool
  | [], _ => true
  | entry :: entries, index =>
      decide (entry = (((packed >>> (12 * index)) % 4096 : Nat))) &&
      pairWitnessPackedPairOrbitEntriesCheck packed entries (index + 1)


def pairWitnessPackedPairOrbitRowsCheck :
    List (Array Int) → List Nat → Bool
  | [], [] => true
  | row :: rows, packed :: remaining =>
      decide (row.size = 425) &&
      pairWitnessPackedPairOrbitEntriesCheck packed row.toList 0 &&
      pairWitnessPackedPairOrbitRowsCheck rows remaining
  | _, _ => false


def pairWitnessPackedGramCheck : List (Array Int) → Nat → Bool
  | [], _ => true
  | row :: rows, index =>
      decide (orbitEntry row 0 =
        (pairWitnessPackedIndex pairWitnessPackedGramLeft index : Nat)) &&
      decide (orbitEntry row 1 =
        (pairWitnessPackedIndex pairWitnessPackedGramRight index : Nat)) &&
      pairWitnessPackedGramCheck rows (index + 1)


def pairWitnessPackedPermutationEntriesCheck
    (packed : Nat) : List Int → Nat → Bool
  | [], _ => true
  | entry :: entries, index =>
      decide (entry = (pairWitnessPackedIndex packed index : Nat)) &&
      pairWitnessPackedPermutationEntriesCheck packed entries (index + 1)


def pairWitnessPackedPermutationsCheck :
    List (Array Int) → List Nat → Bool
  | [], [] => true
  | row :: rows, packed :: remaining =>
      decide (row.size = 425) &&
      pairWitnessPackedPermutationEntriesCheck packed row.toList 0 &&
      pairWitnessPackedPermutationsCheck rows remaining
  | _, _ => false


def pairWitnessPackedImage (symmetry index : Nat) : Nat :=
  pairWitnessPackedIndex
    (pairWitnessPackedPermutationRows.getD symmetry 0) index


def orbitPairWitnessPackedEntryCheck
    (basisOrbit second : Nat) (orbit packed : Int) : Bool :=
  let symmetry := packed.toNat / 2
  let transpose := packed.toNat % 2 = 1
  let left := pairWitnessPackedIndex pairWitnessPackedGramLeft orbit.toNat
  let right := pairWitnessPackedIndex pairWitnessPackedGramRight orbit.toNat
  let first := if transpose then right else left
  let last := if transpose then left else right
  decide (basisOrbit < 26) &&
    decide (second < 425) &&
    decide (0 ≤ orbit ∧ orbit < (2256 : Int)) &&
    decide (0 ≤ packed ∧ packed < (128 : Int)) &&
    decide (first < 425) &&
    decide (last < 425) &&
    decide (pairWitnessPackedImage symmetry first =
      orbitBasisRepresentative basisOrbit) &&
    decide (pairWitnessPackedImage symmetry last = second)


def orbitPairWitnessPackedEntriesCheck
    (basisOrbit : Nat) : Nat → List Int → List Int → Bool
  | _, [], [] => true
  | second, orbit :: orbits, witness :: witnesses =>
      orbitPairWitnessPackedEntryCheck basisOrbit second orbit witness &&
      orbitPairWitnessPackedEntriesCheck basisOrbit
        (second + 1) orbits witnesses
  | _, _, _ => false


def orbitPairWitnessPackedRowsCheck :
    Nat → List (Array Int) → List (Array Int) → Bool
  | _, [], [] => true
  | index, orbit :: orbits, witness :: witnesses =>
      decide (orbit.size = 425) &&
      decide (witness.size = 425) &&
      orbitPairWitnessPackedEntriesCheck index 0
        orbit.toList witness.toList &&
      orbitPairWitnessPackedRowsCheck (index + 1) orbits witnesses
  | _, _, _ => false


theorem pairWitnessPackedGramCheck_valid :
    pairWitnessPackedGramCheck gramOrbitData.toList 0 = true := by
  decide +kernel


theorem pairWitnessPackedPermutationsCheck_valid :
    pairWitnessPackedPermutationsCheck basisPermutationData.toList
      pairWitnessPackedPermutationRows = true := by
  decide +kernel


theorem pairWitnessPackedPairOrbitRowsCheck_valid :
    pairWitnessPackedPairOrbitRowsCheck pairOrbitIndexData.toList
      pairWitnessPackedPairOrbitRows = true := by
  decide +kernel


theorem orbitPairWitnessPackedRowsCheck_valid :
    orbitPairWitnessPackedRowsCheck 0 pairOrbitIndexData.toList
      pairOrbitWitnessData.toList = true := by
  decide +kernel


theorem pairWitnessPackedGramCheck_get
    (rows : List (Array Int)) (start index : Nat)
    (hindex : index < rows.length)
    (hcheck : pairWitnessPackedGramCheck rows start = true) :
    orbitEntry rows[index] 0 =
        (pairWitnessPackedIndex pairWitnessPackedGramLeft
          (start + index) : Nat) ∧
      orbitEntry rows[index] 1 =
        (pairWitnessPackedIndex pairWitnessPackedGramRight
          (start + index) : Nat) := by
  induction rows generalizing start index with
  | nil => simp at hindex
  | cons row rows ih =>
      simp only [pairWitnessPackedGramCheck,
        Bool.and_eq_true, decide_eq_true_eq] at hcheck
      cases index with
      | zero => exact ⟨hcheck.1.1, hcheck.1.2⟩
      | succ index =>
          have hindex' : index < rows.length := by simpa using hindex
          simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
            ih (start + 1) index hindex' hcheck.2


theorem pairWitnessPackedGram_eq_dataEntry
    (index : Nat) (hindex : index < gramOrbitData.size) :
    (pairWitnessPackedIndex pairWitnessPackedGramLeft index : Int) =
        dataEntry gramOrbitData index 0 ∧
      (pairWitnessPackedIndex pairWitnessPackedGramRight index : Int) =
        dataEntry gramOrbitData index 1 := by
  have hentry := pairWitnessPackedGramCheck_get
    gramOrbitData.toList 0 index (by simpa using hindex)
      pairWitnessPackedGramCheck_valid
  simpa [dataEntry, orbitEntry, Array.getD_eq_getD_getElem?, hindex] using
    And.intro hentry.1.symm hentry.2.symm


theorem pairWitnessPackedPermutationEntriesCheck_get
    (packed : Nat) (entries : List Int) (start index : Nat)
    (hindex : index < entries.length)
    (hcheck : pairWitnessPackedPermutationEntriesCheck packed entries start = true) :
    entries[index] =
      (pairWitnessPackedIndex packed (start + index) : Nat) := by
  induction entries generalizing start index with
  | nil => simp at hindex
  | cons entry entries ih =>
      simp only [pairWitnessPackedPermutationEntriesCheck,
        Bool.and_eq_true, decide_eq_true_eq] at hcheck
      cases index with
      | zero => simpa using hcheck.1
      | succ index =>
          have hindex' : index < entries.length := by simpa using hindex
          simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
            ih (start + 1) index hindex' hcheck.2


theorem pairWitnessPackedPermutationsCheck_get
    (rows : List (Array Int)) (packedRows : List Nat)
    (index : Nat) (hindex : index < rows.length)
    (hcheck : pairWitnessPackedPermutationsCheck rows packedRows = true) :
    ∃ packed, packedRows[index]? = some packed ∧
      rows[index].size = 425 ∧
      pairWitnessPackedPermutationEntriesCheck packed rows[index].toList 0 = true := by
  induction rows generalizing packedRows index with
  | nil => simp at hindex
  | cons row rows ih =>
      cases packedRows with
      | nil => simp [pairWitnessPackedPermutationsCheck] at hcheck
      | cons packed packedRows =>
          simp only [pairWitnessPackedPermutationsCheck,
            Bool.and_eq_true, decide_eq_true_eq] at hcheck
          cases index with
          | zero => exact ⟨packed, by simp, hcheck.1.1, hcheck.1.2⟩
          | succ index =>
              have hindex' : index < rows.length := by simpa using hindex
              obtain ⟨value, hvalue, hsize, hentries⟩ :=
                ih packedRows index hindex' hcheck.2
              exact ⟨value, by simpa using hvalue,
                by simpa using hsize, by simpa using hentries⟩


theorem pairWitnessPackedImage_eq_symmetryBasisImage
    (symmetry index : Nat)
    (hsymmetry : symmetry < basisPermutationData.size)
    (hindex : index < 425) :
    pairWitnessPackedImage symmetry index =
      symmetryBasisImage symmetry index := by
  obtain ⟨packed, hpacked, hsize, hentries⟩ :=
    pairWitnessPackedPermutationsCheck_get basisPermutationData.toList
      pairWitnessPackedPermutationRows symmetry
      (by simpa using hsymmetry) pairWitnessPackedPermutationsCheck_valid
  have hsize' : (basisPermutationData[symmetry]).size = 425 := by
    simpa using hsize
  have hentries' : pairWitnessPackedPermutationEntriesCheck packed
      (basisPermutationData[symmetry]).toList 0 = true := by
    simpa using hentries
  have hcolumn : index < (basisPermutationData[symmetry]).size := by
    simpa [hsize'] using hindex
  have hentry := pairWitnessPackedPermutationEntriesCheck_get packed
    (basisPermutationData[symmetry]).toList 0 index
      (by simpa using hcolumn) hentries'
  have hpacked' : pairWitnessPackedPermutationRows.getD symmetry 0 = packed := by
    simp [List.getD_eq_getElem?_getD, hpacked]
  simp only [pairWitnessPackedImage, hpacked']
  have hentry' :
      pairWitnessPackedIndex packed index =
        ((basisPermutationData[symmetry])[index]).toNat := by
    simpa using congrArg Int.toNat hentry.symm
  simpa [symmetryBasisImage, dataEntry,
    Array.getD_eq_getD_getElem?, hsymmetry, hcolumn] using hentry'


theorem pairWitnessPackedPairOrbitEntriesCheck_get
    (packed : Nat) (rows : List Int) (start index : Nat)
    (hindex : index < rows.length)
    (hcheck : pairWitnessPackedPairOrbitEntriesCheck packed rows start = true) :
    rows[index] = (((packed >>> (12 * (start + index))) % 4096 : Nat) : Int) := by
  induction rows generalizing start index with
  | nil => simp at hindex
  | cons row rows ih =>
      simp only [pairWitnessPackedPairOrbitEntriesCheck,
        Bool.and_eq_true, decide_eq_true_eq] at hcheck
      cases index with
      | zero => simpa using hcheck.1
      | succ index =>
          have hindex' : index < rows.length := by simpa using hindex
          simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
            ih (start + 1) index hindex' hcheck.2


theorem pairWitnessPackedPairOrbitRowsCheck_get
    (rows : List (Array Int)) (packedRows : List Nat)
    (index : Nat) (hindex : index < rows.length)
    (hcheck : pairWitnessPackedPairOrbitRowsCheck rows packedRows = true) :
    ∃ packed, packedRows[index]? = some packed ∧
      rows[index].size = 425 ∧
      pairWitnessPackedPairOrbitEntriesCheck packed rows[index].toList 0 = true := by
  induction rows generalizing packedRows index with
  | nil => simp at hindex
  | cons row rows ih =>
      cases packedRows with
      | nil => simp [pairWitnessPackedPairOrbitRowsCheck] at hcheck
      | cons packed packedRows =>
          simp only [pairWitnessPackedPairOrbitRowsCheck,
            Bool.and_eq_true, decide_eq_true_eq] at hcheck
          cases index with
          | zero =>
              exact ⟨packed, by simp, hcheck.1.1, hcheck.1.2⟩
          | succ index =>
              have hindex' : index < rows.length := by simpa using hindex
              obtain ⟨value, hvalue, hsize, hentries⟩ :=
                ih packedRows index hindex' hcheck.2
              exact ⟨value, by simpa using hvalue,
                by simpa using hsize, by simpa using hentries⟩


theorem pairWitnessPackedPairOrbitIndex_eq_dataEntry
    (basisOrbit second : Nat)
    (horbit : basisOrbit < pairOrbitIndexData.size)
    (hsecond : second < 425) :
    (pairWitnessPackedPairOrbitIndex basisOrbit second : Int) =
      dataEntry pairOrbitIndexData basisOrbit second := by
  obtain ⟨packed, hpacked, hsize, hentries⟩ :=
    pairWitnessPackedPairOrbitRowsCheck_get pairOrbitIndexData.toList
      pairWitnessPackedPairOrbitRows basisOrbit
      (by simpa using horbit) pairWitnessPackedPairOrbitRowsCheck_valid
  have hsize' : (pairOrbitIndexData[basisOrbit]).size = 425 := by
    simpa using hsize
  have hentries' : pairWitnessPackedPairOrbitEntriesCheck packed
      (pairOrbitIndexData[basisOrbit]).toList 0 = true := by
    simpa using hentries
  have hcolumn : second < (pairOrbitIndexData[basisOrbit]).size := by
    rw [hsize']
    exact hsecond
  have hentry := pairWitnessPackedPairOrbitEntriesCheck_get packed
    (pairOrbitIndexData[basisOrbit]).toList 0 second
      (by simpa using hcolumn) hentries'
  have hpacked' : pairWitnessPackedPairOrbitRows.getD basisOrbit 0 = packed := by
    simp [List.getD_eq_getElem?_getD, hpacked]
  simp only [pairWitnessPackedPairOrbitIndex, hpacked']
  simpa [dataEntry, Array.getD_eq_getD_getElem?, horbit, hcolumn] using
    hentry.symm


theorem pairWitnessDataSizes_valid :
    basisData.size = 425 ∧
      gramOrbitData.size = 2256 ∧
      symmetryData.size = 64 ∧
      basisPermutationData.size = 64 ∧
      basisOrbitRepresentativeData.size = 26 ∧
      pairOrbitIndexData.size = 26 ∧
      pairOrbitWitnessData.size = 26 := by
  decide +kernel



theorem orbitPairWitnessPackedEntryCheck_sound
    (basisOrbit second : Nat) (orbit packed : Int)
    (horbit : dataEntry pairOrbitIndexData basisOrbit second = orbit)
    (hpacked : dataEntry pairOrbitWitnessData basisOrbit second = packed)
    (hcheck : orbitPairWitnessPackedEntryCheck
      basisOrbit second orbit packed = true) :
    orbitPairWitnessEntryCheck basisOrbit second = true := by
  simp only [orbitPairWitnessPackedEntryCheck,
    Bool.and_eq_true, decide_eq_true_eq, and_assoc] at hcheck
  obtain ⟨hbasisOrbit, hsecond, horbitNonneg, horbitLt,
    hpackedNonneg, hpackedLt, hfirst, hlast,
    hfirstImage, hlastImage⟩ := hcheck
  have hgramIndex : orbit.toNat < gramOrbitData.size := by
    rw [pairWitnessDataSizes_valid.2.1]
    exact (Int.toNat_lt horbitNonneg).mpr horbitLt
  have hgram := pairWitnessPackedGram_eq_dataEntry orbit.toNat hgramIndex
  have hleft : orbitEntry (gramOrbitData.getD orbit.toNat #[]) 0 =
      (pairWitnessPackedIndex pairWitnessPackedGramLeft orbit.toNat : Int) := by
    simpa [dataEntry, orbitEntry] using hgram.1.symm
  have hright : orbitEntry (gramOrbitData.getD orbit.toNat #[]) 1 =
      (pairWitnessPackedIndex pairWitnessPackedGramRight orbit.toNat : Int) := by
    simpa [dataEntry, orbitEntry] using hgram.2.symm
  let transpose := packed.toNat % 2 = 1
  let first := if transpose then
    pairWitnessPackedIndex pairWitnessPackedGramRight orbit.toNat
  else
    pairWitnessPackedIndex pairWitnessPackedGramLeft orbit.toNat
  let last := if transpose then
    pairWitnessPackedIndex pairWitnessPackedGramLeft orbit.toNat
  else
    pairWitnessPackedIndex pairWitnessPackedGramRight orbit.toNat
  have hsymmetry : packed.toNat / 2 < basisPermutationData.size := by
    rw [pairWitnessDataSizes_valid.2.2.2.1]
    have hpackedNat : packed.toNat < 128 :=
      (Int.toNat_lt hpackedNonneg).mpr hpackedLt
    omega
  have hfirstNat : first < 425 := hfirst
  have hlastNat : last < 425 := hlast
  have hfirstSemantic := pairWitnessPackedImage_eq_symmetryBasisImage
    (packed.toNat / 2) first hsymmetry hfirstNat
  have hlastSemantic := pairWitnessPackedImage_eq_symmetryBasisImage
    (packed.toNat / 2) last hsymmetry hlastNat
  have hfirstRepresentative :
      (if transpose then
        orbitEntry (gramOrbitData.getD orbit.toNat #[]) 1
      else
        orbitEntry (gramOrbitData.getD orbit.toNat #[]) 0) = (first : Int) := by
    simp only [first]
    split <;> simp_all
  have hlastRepresentative :
      (if transpose then
        orbitEntry (gramOrbitData.getD orbit.toNat #[]) 0
      else
        orbitEntry (gramOrbitData.getD orbit.toNat #[]) 1) = (last : Int) := by
    simp only [last]
    split <;> simp_all
  have hfirstRepresentative' :
      (if packed.toNat % 2 = 1 then
        orbitEntry (gramOrbitData.getD orbit.toNat #[]) 1
      else
        orbitEntry (gramOrbitData.getD orbit.toNat #[]) 0) = (first : Int) := by
    simpa [transpose] using hfirstRepresentative
  have hlastRepresentative' :
      (if packed.toNat % 2 = 1 then
        orbitEntry (gramOrbitData.getD orbit.toNat #[]) 0
      else
        orbitEntry (gramOrbitData.getD orbit.toNat #[]) 1) = (last : Int) := by
    simpa [transpose] using hlastRepresentative
  simp only [orbitPairWitnessEntryCheck, horbit, hpacked,
    pairWitnessDataSizes_valid.1,
    pairWitnessDataSizes_valid.2.1,
    pairWitnessDataSizes_valid.2.2.1,
    pairWitnessDataSizes_valid.2.2.2.2.1,
    hfirstRepresentative', hlastRepresentative',
    Int.toNat_natCast, orbitIndexCheck, Bool.and_eq_true,
    decide_eq_true_eq, and_assoc]
  refine ⟨hbasisOrbit, hsecond, horbitNonneg, horbitLt,
    hpackedNonneg, hpackedLt, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · omega
  · omega
  · omega
  · omega
  · calc
      symmetryBasisImage (packed.toNat / 2) first =
          pairWitnessPackedImage (packed.toNat / 2) first :=
        hfirstSemantic.symm
      _ = orbitBasisRepresentative basisOrbit := by
        simpa [first, transpose] using hfirstImage
  · calc
      symmetryBasisImage (packed.toNat / 2) last =
          pairWitnessPackedImage (packed.toNat / 2) last :=
        hlastSemantic.symm
      _ = second := by
        simpa [last, transpose] using hlastImage

end

