noncomputable def factorRowChunk : Nat → List (List Int)
  | 0 => factorRowChunk000
  | 1 => factorRowChunk001
  | 2 => factorRowChunk002
  | 3 => factorRowChunk003
  | 4 => factorRowChunk004
  | 5 => factorRowChunk005
  | 6 => factorRowChunk006
  | 7 => factorRowChunk007
  | 8 => factorRowChunk008
  | 9 => factorRowChunk009
  | 10 => factorRowChunk010
  | 11 => factorRowChunk011
  | 12 => factorRowChunk012
  | 13 => factorRowChunk013
  | 14 => factorRowChunk014
  | 15 => factorRowChunk015
  | 16 => factorRowChunk016
  | _ => []

noncomputable def factorRow (r : Nat) : List Int :=
  (factorRowChunk (r / 25)).getD (r % 25) []

@[irreducible] noncomputable def factorData : List (List Int) :=
  List.flatten [
    factorRowChunk000, factorRowChunk001, factorRowChunk002,
    factorRowChunk003, factorRowChunk004, factorRowChunk005,
    factorRowChunk006, factorRowChunk007, factorRowChunk008,
    factorRowChunk009, factorRowChunk010, factorRowChunk011,
    factorRowChunk012, factorRowChunk013, factorRowChunk014,
    factorRowChunk015, factorRowChunk016]


noncomputable abbrev fullGramData : List (List Int) :=
  AffineSymplecticCertificate.coefficientFullGramData



def gramEncodingBase : Int := 100000000000000000000


def encodeGramRow (entries : List Int) : Int :=
  entries.foldr (fun entry result ↦ entry + gramEncodingBase * result) 0

set_option maxHeartbeats 0 in

