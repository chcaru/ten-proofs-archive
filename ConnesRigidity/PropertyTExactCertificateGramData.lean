@[irreducible] noncomputable def encodedFactorRows : List Int :=
  encodedFactorRowData.map fun row ↦ row.headD 0

def fullFactorCoefficient (row : List Int) (i : Nat) : Int :=
  if i = 0 then -row.sum else row.getD (i - 1) 0

noncomputable def fullGramCoefficient (i j : Nat) : Int :=
  (fullGramData.getD i []).getD j 0

