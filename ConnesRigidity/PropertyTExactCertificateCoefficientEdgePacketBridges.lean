private theorem coefficientChunksPrefix
    {α : Type*} (entries : List α) (size count : Nat) :
    ((List.range count).map fun i =>
      (entries.drop (i * size)).take size).flatten =
        entries.take (count * size) := by
  induction count with
  | zero =>
      simp
  | succ count ih =>
      rw [List.range_succ, List.map_append, List.flatten_append, ih]
      simp [Nat.succ_mul, List.take_add]

