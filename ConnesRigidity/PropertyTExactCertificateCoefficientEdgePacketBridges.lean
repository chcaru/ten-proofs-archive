  apply List.take_of_length_le
  unfold positiveEdgeTerms
  decide +kernel

theorem allDiagonalPacketTermChunkBridges
    (i : Fin 7) :
    coefficientDiagonalPacketTermChunk i =
      (diagonalTerms.drop (i * 256)).take
        256 := by
  fin_cases i
  · exact coefficientDiagonalPacketTermsBridge_000
  · exact coefficientDiagonalPacketTermsBridge_001
  · exact coefficientDiagonalPacketTermsBridge_002
  · exact coefficientDiagonalPacketTermsBridge_003
  · exact coefficientDiagonalPacketTermsBridge_004
  · exact coefficientDiagonalPacketTermsBridge_005
  · exact coefficientDiagonalPacketTermsBridge_006

theorem coefficientDiagonalPacketTermChunks_flatten :
    coefficientDiagonalPacketTermChunks.flatten = diagonalTerms := by
  unfold coefficientDiagonalPacketTermChunks
  rw [show
      (List.range 7).map coefficientDiagonalPacketTermChunk =
        (List.range 7).map (fun i =>
          (diagonalTerms.drop (i * 256)).take
            256) by
    apply List.map_congr_left
    intro i hi
    exact allDiagonalPacketTermChunkBridges
      ⟨i, List.mem_range.mp hi⟩]
  rw [coefficientChunksPrefix]
  apply List.take_of_length_le
  unfold diagonalTerms
  decide +kernel

