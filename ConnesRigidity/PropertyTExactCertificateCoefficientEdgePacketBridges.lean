theorem coefficientNegativePacketTermChunks_flatten :
    coefficientNegativePacketTermChunks.flatten = negativeEdgeTerms := by
  unfold coefficientNegativePacketTermChunks
  rw [show
      (List.range 152).map coefficientNegativePacketTermChunk =
        (List.range 152).map (fun i =>
          (negativeEdgeTerms.drop (i * 512)).take
            512) by
    apply List.map_congr_left
    intro i hi
    exact allNegativePacketTermChunkBridges
      ⟨i, List.mem_range.mp hi⟩]
  rw [coefficientChunksPrefix]
  apply List.take_of_length_le
  unfold negativeEdgeTerms
  decide +kernel

