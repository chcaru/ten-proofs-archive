  have hsurface : 0 < radialSurfaceArea d :=
    radialSurfaceArea_pos hd
  have hmellin :
      (d : ℂ) / 2 - Complex.I * z =
        -(Complex.I * (y : ℂ)) := by
    try dsimp [z]
    push_cast
