theorem johnsonAdjacentRawScalar_sq
    {n w p q t : ℕ}
    (hw : 0 < w) (hwn : w < n)
    (_ : 2 * p + (t + 1) ≤ w)
    (hcomplement : 2 * q + (t + 1) ≤ n - w) :
    johnsonAdjacentRawScalar n w p q t ^ 2 =
      ((n : ℝ) /
