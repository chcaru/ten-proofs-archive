      (fun T : ℝ =>
        ∫ a in A..B,
          saddleMellinInversePower r
            ((a : ℂ) + ((s * T : ℝ) : ℂ) * Complex.I) *
            plusSaddleMellinData ε ℓ
              ((a : ℂ) + ((s * T : ℝ) : ℂ) * Complex.I))
