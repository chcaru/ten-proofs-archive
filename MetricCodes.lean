theorem saddle_one_add_abs_cube_le (T : ℝ) :
    (1 + |T|) ^ 3 ≤ 4 * (1 + |T| ^ 3) := by
  have hfactor : 0 ≤
      (|T| - 1) ^ 2 * (|T| + 1) :=
    mul_nonneg (sq_nonneg _) (by positivity)
  nlinarith



theorem plusPolynomial_imaginary_norm_ge_beta
    {ε u : ℝ} (hε : 0 < ε) (hu : -1 ≤ u) :
    beta ε ≤ ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ := by
  have hb : 0 < beta ε := beta_pos hε
  have hterm : 0 ≤ (1 - u) ^ 2 * (1 + u) :=
    mul_nonneg (sq_nonneg _) (by linarith)
  have hvalue : 0 < beta ε + (1 - u) ^ 2 * (1 + u) :=
    add_pos_of_pos_of_nonneg hb hterm
  rw [plusPolynomial_imaginary, Complex.norm_real,
    Real.norm_eq_abs, abs_of_pos hvalue]
  linarith




theorem plusPolynomial_imaginary_cubic_growth_le
    {ε u : ℝ} (hε : 0 < ε) (hu : -1 ≤ u) :
    (1 + |u|) ^ 3 ≤
      (27 / beta ε + 9) *
        ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ := by
  have hb : 0 < beta ε := beta_pos hε
  have hnorm :
      beta ε ≤ ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ :=
    plusPolynomial_imaginary_norm_ge_beta hε hu
  by_cases hbounded : u ≤ 2
  · have habs : |u| ≤ 2 := by
      exact (abs_le).mpr ⟨by linarith, hbounded⟩
    have hcube : (1 + |u|) ^ 3 ≤ 27 := by
      have hbase : 1 + |u| ≤ (3 : ℝ) := by linarith
      have hpow := pow_le_pow_left₀
        (show 0 ≤ 1 + |u| by positivity) hbase 3
      norm_num at hpow ⊢
      exact hpow
    calc
      (1 + |u|) ^ 3 ≤ 27 := hcube
      _ = (27 / beta ε) * beta ε := by
        field_simp [hb.ne']
      _ ≤ (27 / beta ε) *
          ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ :=
        mul_le_mul_of_nonneg_left hnorm (by positivity)
      _ ≤ (27 / beta ε + 9) *
          ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ := by
        have hnonnegative :=
          norm_nonneg (plusPolynomial ε (Complex.I * (u : ℂ)))
        nlinarith
  · have hlarge : 2 < u := lt_of_not_ge hbounded
    have habs : |u| = u := abs_of_pos (by linarith)
    have hvalue :
        ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ =
          beta ε + (1 - u) ^ 2 * (1 + u) := by
      rw [plusPolynomial_imaginary, Complex.norm_real,
        Real.norm_eq_abs]
      apply abs_of_pos
      exact add_pos_of_pos_of_nonneg hb
        (mul_nonneg (sq_nonneg _) (by linarith))
    have hsq :
        (1 + u) ^ 2 ≤ 9 * (1 - u) ^ 2 := by
      have hfactor : 0 ≤ (2 * u - 1) * (u - 2) :=
        mul_nonneg (by linarith) (by linarith)
      nlinarith
    have hcube :
        (1 + u) ^ 3 ≤
          9 * ((1 - u) ^ 2 * (1 + u)) := by
      have hproduct := mul_le_mul_of_nonneg_right
        hsq (show 0 ≤ 1 + u by linarith)
      nlinarith
    rw [habs]
    calc
      (1 + u) ^ 3 ≤
          9 * ((1 - u) ^ 2 * (1 + u)) := hcube
      _ ≤ 9 * ‖plusPolynomial ε
          (Complex.I * (u : ℂ))‖ := by
        rw [hvalue]
        nlinarith
      _ ≤ (27 / beta ε + 9) *
          ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ := by
        have hnonnegative :=
          norm_nonneg (plusPolynomial ε (Complex.I * (u : ℂ)))
        have hcoefficient : 0 ≤ 27 / beta ε := by
          positivity
        nlinarith [mul_nonneg hcoefficient hnonnegative]



theorem minusPolynomial_imaginary_norm_ge_three_beta
    {ε u : ℝ} (hε : 0 < ε)
    (hu : 1 + ε / 4 ≤ u) :
    3 * beta ε ≤
      ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ := by
  have hb : 0 < beta ε := beta_pos hε
  have hone : 1 ≤ u := by linarith
  have hbeta : beta ε ≤ u - 1 := by
    unfold beta
    linarith
  have hsquare : (4 : ℝ) ≤ (1 + u) ^ 2 := by
    nlinarith [sq_nonneg (u - 1)]
  have hproduct :
      4 * beta ε ≤ (u - 1) * (1 + u) ^ 2 := by
    calc
      4 * beta ε = beta ε * 4 := by ring
      _ ≤ (u - 1) * (1 + u) ^ 2 :=
        mul_le_mul hbeta hsquare (by norm_num) (by linarith)
  have hnegative := minusPolynomial_imaginary_re_neg hε hu
  rw [minusPolynomial_imaginary, Complex.norm_real,
    Real.norm_eq_abs]
  have harg : beta ε + (1 - u) * (1 + u) ^ 2 < 0 := by
    rw [minusPolynomial_imaginary, Complex.ofReal_re]
      at hnegative
    exact hnegative
  rw [abs_of_neg harg]
  nlinarith



theorem minusPolynomial_imaginary_cubic_growth_le
    {ε u : ℝ} (hε : 0 < ε)
    (hu : 1 + ε / 4 ≤ u) :
    (1 + |u|) ^ 3 ≤
      (9 / beta ε + 6) *
        ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ := by
  have hb : 0 < beta ε := beta_pos hε
  have hone : 1 ≤ u := by linarith
  have hbeta : beta ε ≤ u - 1 := by
    unfold beta
    linarith
  have habs : |u| = u := abs_of_pos (by linarith)
  have hnorm := minusPolynomial_imaginary_norm_ge_three_beta
    hε hu
  by_cases hbounded : u ≤ 2
  · have hcube : (1 + |u|) ^ 3 ≤ 27 := by
      have hbase : 1 + |u| ≤ (3 : ℝ) := by
        rw [habs]
        linarith
      have hpow := pow_le_pow_left₀
        (show 0 ≤ 1 + |u| by positivity) hbase 3
      norm_num at hpow ⊢
      exact hpow
    calc
      (1 + |u|) ^ 3 ≤ 27 := hcube
      _ = (9 / beta ε) * (3 * beta ε) := by
        field_simp [hb.ne']; norm_num
      _ ≤ (9 / beta ε) *
          ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ :=
        mul_le_mul_of_nonneg_left hnorm (by positivity)
      _ ≤ (9 / beta ε + 6) *
          ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ := by
        have hnonnegative :=
          norm_nonneg (minusPolynomial ε
            (Complex.I * (u : ℂ)))
        nlinarith
  · have hlarge : 2 < u := lt_of_not_ge hbounded
    have hnegative := minusPolynomial_imaginary_re_neg hε hu
    have hvalue :
        ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ =
          (u - 1) * (1 + u) ^ 2 - beta ε := by
      rw [minusPolynomial_imaginary, Complex.norm_real,
        Real.norm_eq_abs]
      have harg : beta ε + (1 - u) * (1 + u) ^ 2 < 0 := by
        rw [minusPolynomial_imaginary, Complex.ofReal_re]
          at hnegative
        exact hnegative
      rw [abs_of_neg harg]
      ring
    have hsquare : (4 : ℝ) ≤ (1 + u) ^ 2 := by
      nlinarith [sq_nonneg (u - 1)]
    have hterm :
        2 * beta ε ≤ (u - 1) * (1 + u) ^ 2 := by
      calc
        2 * beta ε ≤ 4 * beta ε := by nlinarith
        _ = beta ε * 4 := by ring
        _ ≤ (u - 1) * (1 + u) ^ 2 :=
          mul_le_mul hbeta hsquare (by norm_num) (by linarith)
    have hlinear : 1 + u ≤ 3 * (u - 1) := by
      linarith
    have hcubic :
        (1 + u) ^ 3 ≤
          3 * ((u - 1) * (1 + u) ^ 2) := by
      have hproduct :=
        mul_le_mul_of_nonneg_right hlinear (sq_nonneg (1 + u))
      nlinarith
    rw [habs]
    calc
      (1 + u) ^ 3 ≤
          3 * ((u - 1) * (1 + u) ^ 2) := hcubic
      _ ≤ 6 * ‖minusPolynomial ε
          (Complex.I * (u : ℂ))‖ := by
        rw [hvalue]
        nlinarith
      _ ≤ (9 / beta ε + 6) *
          ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ := by
        have hnonnegative :=
          norm_nonneg (minusPolynomial ε
            (Complex.I * (u : ℂ)))
        have hcoefficient : 0 ≤ 9 / beta ε := by
          positivity
        nlinarith [mul_nonneg hcoefficient hnonnegative]



theorem saddle_complex_frequency_norm_le (T u : ℝ) :
    ‖(T : ℂ) + Complex.I * (u : ℂ)‖ ≤ |T| + |u| := by
  calc
    ‖(T : ℂ) + Complex.I * (u : ℂ)‖ ≤
        ‖(T : ℂ)‖ + ‖Complex.I * (u : ℂ)‖ :=
      norm_add_le _ _
    _ = |T| + |u| := by
      simp [Complex.norm_real, Real.norm_eq_abs]



theorem exists_plusPolynomial_uniform_norm_ratio
    {ε : ℝ} (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧
      ∀ u : ℝ, -1 ≤ u → ∀ T : ℝ,
        ‖plusPolynomial ε
            ((T : ℂ) + Complex.I * (u : ℂ))‖ /
          ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ ≤
            C * (1 + |T| ^ 3) := by
  have hb : 0 < beta ε := beta_pos hε
  refine ⟨4 * (1 + beta ε) * (27 / beta ε + 9),
    by positivity, ?_⟩
  intro u hu T
  let z : ℂ := (T : ℂ) + Complex.I * (u : ℂ)
  let D : ℝ := ‖plusPolynomial ε (Complex.I * (u : ℂ))‖
  have hD : 0 < D :=
    lt_of_lt_of_le hb (plusPolynomial_imaginary_norm_ge_beta hε hu)
  have htriangle :
      1 + ‖z‖ ≤ (1 + |T|) * (1 + |u|) := by
    have hz := saddle_complex_frequency_norm_le T u
    change ‖z‖ ≤ |T| + |u| at hz
    nlinarith [mul_nonneg (abs_nonneg T) (abs_nonneg u)]
  have hpower :
      (1 + ‖z‖) ^ 3 ≤
        ((1 + |T|) * (1 + |u|)) ^ 3 :=
    pow_le_pow_left₀ (by positivity) htriangle 3
  have hbase := norm_plusPolynomial_le ε z
  rw [abs_of_pos hb] at hbase
  have hfrequency := saddle_one_add_abs_cube_le T
  have hheight := plusPolynomial_imaginary_cubic_growth_le
    hε hu
  change ‖plusPolynomial ε z‖ / D ≤
    (4 * (1 + beta ε) * (27 / beta ε + 9)) *
      (1 + |T| ^ 3)
  apply (div_le_iff₀ hD).2
  calc
    ‖plusPolynomial ε z‖ ≤
        (1 + beta ε) * (1 + ‖z‖) ^ 3 := hbase
    _ ≤ (1 + beta ε) *
        ((1 + |T|) * (1 + |u|)) ^ 3 := by
      gcongr
    _ = (1 + beta ε) * (1 + |T|) ^ 3 *
        (1 + |u|) ^ 3 := by
      ring
    _ ≤ (1 + beta ε) *
        (4 * (1 + |T| ^ 3)) *
          ((27 / beta ε + 9) * D) := by
      gcongr
    _ = ((4 * (1 + beta ε) * (27 / beta ε + 9)) *
        (1 + |T| ^ 3)) * D := by
      ring



