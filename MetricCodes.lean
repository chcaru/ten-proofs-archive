theorem saddleMellinGamma_differentiableAt_of_re_pos
    {z : ℂ} (hz : 0 < z.re) :
    DifferentiableAt ℂ (fun w : ℂ => Complex.Gamma (w / 2)) z := by
  have hhalf : 0 < (z / 2).re := by
    simpa using! half_pos hz
