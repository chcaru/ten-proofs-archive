  have hsupport := sum_coordinateIndicator_mul_function x
    (fun i : Fin n => MetricCodes.Boolean.lowerAt i f S)
  simp only [Pi.smul_apply, Pi.sub_apply, smul_eq_mul,
    johnsonSupportLower, MetricCodes.Boolean.lower]
