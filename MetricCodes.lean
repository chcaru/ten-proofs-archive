  have hleft :
      (∫ u in (0 : ℝ)..1,
        (-u / 2) *
          (Real.log (((1 - u ^ 2) / 4 + a * (1 + a)) /
            ((1 - u ^ 2) / 4)) /
            Real.sqrt (1 / 4 - (1 - u ^ 2) / 4))) =
        ∫ u in (0 : ℝ)..1,
          -Real.log (((1 - u ^ 2) / 4 + a * (1 + a)) /
            ((1 - u ^ 2) / 4)) := by
    apply intervalIntegral.integral_congr_Ioo_of_le (by norm_num)
    intro u hu
    change (-u / 2) *
      (Real.log (((1 - u ^ 2) / 4 + a * (1 + a)) /
        ((1 - u ^ 2) / 4)) /
        Real.sqrt (1 / 4 - (1 - u ^ 2) / 4)) =
      -Real.log (((1 - u ^ 2) / 4 + a * (1 + a)) /
        ((1 - u ^ 2) / 4))
    have hu0 : 0 < u := hu.1
    have hsqrt : Real.sqrt (u ^ 2 / 4) = u / 2 := by
