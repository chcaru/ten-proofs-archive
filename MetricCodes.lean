          (∫ T : ℝ in saddleGaussianTailSet R,
            saddleGaussianTailWeight T *
              Real.exp
                (-saddleSourceContourDamping
                  ε ℓ (1 + δ) T)) ≤ _
        exact mul_le_mul_of_nonneg_left hsource hs
    _ = _ := by
      have hexponent' :
          (saddleSourceSecondBranchGaussianRate
            ε ℓ δ / 4) *
            (z / Real.sqrt (ℓ * V)) ^ 2 =
              z ^ 2 / (400 * Real.exp 1) := by
