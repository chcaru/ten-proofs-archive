      ∀ u : ℝ, 1 + ε / 4 ≤ u → ∀ T : ℝ,
        ‖minusPolynomial ε
            ((T : ℂ) + Complex.I * (u : ℂ)) -
          minusPolynomial ε (Complex.I * (u : ℂ))‖ ≤
          C * (|T| + |T| ^ 3) *
            ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_minusPolynomial_uniform_difference_ratio hε
  refine ⟨C, hC, ?_⟩
  intro u hu T
  have hden : 0 <
