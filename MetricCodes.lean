    Complex.I * ((a * T : ℝ) : ℂ) +
      (((a * T) ^ 2 / 2 : ℝ) : ℂ)) *
        (upperGammaMeasureDensity ℓ η a : ℂ)




theorem upperGammaCubicRemainderKernel_norm_le
    {ℓ η a : ℝ} (hℓ : 0 < ℓ) (ha : 0 < a)
