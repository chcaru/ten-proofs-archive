        (tendsto_natCast_atTop_atTop (R := ℝ))
    have hevent : ∀ᶠ n : ℕ in atTop, -(n : ℝ) ≤ b Y :=
      ht.eventually (Iic_mem_atBot (b Y))
    apply tendsto_const_nhds.congr'
