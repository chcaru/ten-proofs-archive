  congr 1
  simp [Complex.mul_re]




def saddleNegativeMellinMajorantCoefficient
    (ε ℓ : ℝ) (N : ℕ) : ℝ :=
  27 * (1 + |beta ε|) *
    Real.exp (2 * ε * Real.log 2) *
