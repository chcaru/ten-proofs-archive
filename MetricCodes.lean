          (((k : ℝ) + 1 / 2) * Real.log (Real.pi * R ^ 2)) *
            Real.exp ((-a) * |y|)) :=
    (strip_exp_abs_integrable ha).const_mul
      (((k : ℝ) + 1 / 2) * Real.log (Real.pi * R ^ 2))
  have hsum :
