theorem saddleMellinShellArgument_zero {ℓ : ℝ}
    (hℓ : 0 < ℓ) :
    Complex.I * ((0 : ℂ) - (ℓ : ℂ)) / (ℓ : ℂ) =
      -Complex.I := by
  have hc : (ℓ : ℂ) ≠ 0 := by
    exact_mod_cast hℓ.ne'
  field_simp [hc]; ring




theorem saddleMellinShellArgument_neg_even {ℓ : ℝ}
    (hℓ : 0 < ℓ) (n : ℕ) :
    Complex.I *
        ((-((2 * n : ℕ) : ℂ)) - (ℓ : ℂ)) / (ℓ : ℂ) =
      Complex.I *
        ((-(1 + 2 * (n : ℝ) / ℓ) : ℝ) : ℂ) := by
