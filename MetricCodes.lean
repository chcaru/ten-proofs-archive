  have hdimension :=
    tendsto_saddleResidue_dimension_half.eventually hrelative
  filter_upwards [hdimension, hstar]
    with d hres hcut
  intro r hr hrstar
  try dsimp
  exact hres (saddleSmallRadiusVariable ε r)
    (saddleSmallRadiusVariable_nonneg ε r)
    (hcut r hr hrstar)


