theorem plusSaddleOuterSquaredProfile_eq_positiveContour
    {ε ℓ a u : ℝ}
    (hε : 0 < ε) (hℓ : 0 < ℓ)
    (horder : shortCutoff ε ≤ shortEndpoint ε)
    (ha : 0 < a) (hu : 3 < u) :
    plusSaddleOuterSquaredProfile ε ℓ u =
      plusSaddlePositiveSquaredContour ε ℓ a u := by
