      (fun n => saddlePositiveContour_ne_pole hB n) hr
  have hlower :
      Tendsto
        (fun T : ℝ =>
          ∫ a in A..B,
            F ((a : ℂ) + ((-T : ℝ) : ℂ) * Complex.I))
