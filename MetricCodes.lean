        (plusPolynomial_imaginary_norm_ge_beta hε hu.le)
    have hcentral :=
      saddleSourceCenteredPlusIntegrand_centralGaussianError_le
        hε hℓ hu horder hmargin' hV hR hq.le hqone hq.le
        hphase hpoly
    calc
      ‖∫ T : ℝ in Icc (-R) R,
