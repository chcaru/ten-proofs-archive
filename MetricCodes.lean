        lowerGammaBoundaryCapped ((d : ℝ) / 2)
          (c * Real.sqrt d) D (((d : ℝ) / 2) * Y))) := by
  let b : ℝ → ℝ := fun Y =>
    lowerGammaBoundaryCapped ((d : ℝ) / 2)
      (c * Real.sqrt d) D (((d : ℝ) / 2) * Y)
