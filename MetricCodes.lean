    · exact hsmall_d ‖x‖ (norm_nonneg x) hx
    · exact hlarge_d ‖x‖ hx
  · intro x hx
    change (minusSaddleProfile ε ((d : ℝ) / 2) ‖x‖).re ≤ 0
    exact hminus_d ‖x‖ hx

