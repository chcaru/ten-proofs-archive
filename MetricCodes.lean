    calc
      ‖stripRegularizedHolomorphicPoissonKernel ℓ z y‖ *
          |lowerGammaBoundaryLog ℓ R y| ≤
        (Real.exp (Real.pi * (z.re - y) / (2 * ℓ)) / D) *
          |lowerGammaBoundaryLog ℓ R y| :=
        mul_le_mul_of_nonneg_right hbound (abs_nonneg _)
      _ = Cpos *
          (Real.exp ((-a) * |y|) *
            |lowerGammaBoundaryLog ℓ R y|) := by
