section










open scoped BigOperators FourierTransform

open MeasureTheory

namespace SchwartzMap.PoissonSummation.Standard

variable {d : ℕ}


open UnitAddTorus

variable (f : 𝓢(EuclideanSpace ℝ (Fin d), ℂ))


noncomputable def ball : TopologicalSpace.Compacts (EuclideanSpace ℝ (Fin d)) :=
  ⟨Metric.closedBall (0 : (EuclideanSpace ℝ (Fin d))) (Real.sqrt d), isCompact_closedBall (0 : (EuclideanSpace ℝ (Fin d))) (Real.sqrt d)⟩

lemma norm_mFourier_mul_translate_le (n : Fin d → ℤ) (ℓ : (SchwartzMap.standardLattice d))
    (x : (EuclideanSpace ℝ (Fin d))) (hx : x ∈ SchwartzMap.PoissonSummation.Standard.iocCube (d := d)) :
    ‖UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) *
          f (x + (ℓ : (EuclideanSpace ℝ (Fin d))))‖ ≤ ‖(translate (d := d) f ℓ).restrict (ball (d := d))‖ := by
  have hxK : x ∈ (ball (d := d) : Set (EuclideanSpace ℝ (Fin d))) := (iocCube_subset_closedBall (d := d)) hx
  have hmFourier :
      ‖UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x)‖ ≤ 1 := by
    simpa [UnitAddTorus.mFourier_norm (d := Fin d) (n := -n)] using!
      (ContinuousMap.norm_coe_le_norm (UnitAddTorus.mFourier (-n))
        (PoissonSummation.Standard.coeFunE (d := d) x))
  have hsup :
      ‖f (x + (ℓ : (EuclideanSpace ℝ (Fin d))))‖ ≤ ‖(translate (d := d) f ℓ).restrict (ball (d := d))‖ := by
    simpa [translate_apply, ContinuousMap.restrict_apply] using!
      (ContinuousMap.norm_coe_le_norm ((translate (d := d) f ℓ).restrict (ball (d := d))) ⟨x, hxK⟩)
  calc
    ‖UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) *
          f (x + (ℓ : (EuclideanSpace ℝ (Fin d))))‖
        = ‖UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x)‖ *
            ‖f (x + (ℓ : (EuclideanSpace ℝ (Fin d))))‖ := by simp
    _ ≤ 1 * ‖f (x + (ℓ : (EuclideanSpace ℝ (Fin d))))‖ := by gcongr
    _ = ‖f (x + (ℓ : (EuclideanSpace ℝ (Fin d))))‖ := by simp
    _ ≤ ‖(translate (d := d) f ℓ).restrict (ball (d := d))‖ := hsup

lemma summable_integral_norm_mFourier_mul_translate_iocCube (n : Fin d → ℤ) :
    Summable
        (fun ℓ : (SchwartzMap.standardLattice d) =>
          ∫ x in SchwartzMap.PoissonSummation.Standard.iocCube (d := d),
            ‖UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) *
                f (x + (ℓ : (EuclideanSpace ℝ (Fin d))))‖ ∂(volume : Measure (EuclideanSpace ℝ (Fin d)))) := by
  let s : Set (EuclideanSpace ℝ (Fin d)) := SchwartzMap.PoissonSummation.Standard.iocCube (d := d)
  let μ : Measure (EuclideanSpace ℝ (Fin d)) := (volume : Measure (EuclideanSpace ℝ (Fin d))).restrict s
  haveI : IsFiniteMeasure μ := by
    refine ⟨?_⟩
    simpa [μ, s] using! (volume_iocCube_lt_top (d := d))
  have hsum_norm :
      Summable (fun ℓ : (SchwartzMap.standardLattice d) =>
        μ.real Set.univ * ‖(translate (d := d) f ℓ).restrict (ball (d := d))‖) := by
    simpa [mul_assoc, mul_comm, mul_left_comm] using!
      (summable_norm_translate_restrict (d := d) f (ball (d := d))).mul_left (μ.real Set.univ)
  refine Summable.of_nonneg_of_le (fun _ => by positivity) (fun ℓ => ?_) hsum_norm
  have hle_ae :
      (fun x : (EuclideanSpace ℝ (Fin d)) =>
        ‖UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) *
              f (x + (ℓ : (EuclideanSpace ℝ (Fin d))))‖) ≤ᵐ[μ] fun _ : (EuclideanSpace ℝ (Fin d)) =>
        ‖(translate (d := d) f ℓ).restrict (ball (d := d))‖ := by
    refine ae_restrict_of_forall_mem
      (SchwartzMap.PoissonSummation.Standard.measurableSet_iocCube (d := d)) ?_
    intro x hx
    exact norm_mFourier_mul_translate_le (d := d) (f := f) n ℓ x hx
  have hnonneg :
      (0 : (EuclideanSpace ℝ (Fin d)) → ℝ) ≤ᵐ[μ] fun x : (EuclideanSpace ℝ (Fin d)) =>
        ‖UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) *
              f (x + (ℓ : (EuclideanSpace ℝ (Fin d))))‖ :=
    ae_of_all _ (fun _ => by positivity)
  have hle' :
      (∫ x, ‖UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) *
              f (x + (ℓ : (EuclideanSpace ℝ (Fin d))))‖ ∂μ) ≤
        μ.real Set.univ * ‖(translate (d := d) f ℓ).restrict (ball (d := d))‖ := by

    have hle :
        (∫ x, ‖UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) *
                f (x + (ℓ : (EuclideanSpace ℝ (Fin d))))‖ ∂μ) ≤
          ∫ x, ‖(translate (d := d) f ℓ).restrict (ball (d := d))‖ ∂μ :=
      integral_mono_of_nonneg hnonneg
        (integrable_const ‖(translate (d := d) f ℓ).restrict (ball (d := d))‖) hle_ae
    simpa [MeasureTheory.integral_const (μ := μ), smul_eq_mul, mul_comm] using! hle

  simpa [μ, s, mul_comm, mul_left_comm, mul_assoc] using! hle'

lemma mFourierCoeff_descended (n : Fin d → ℤ) :
    UnitAddTorus.mFourierCoeff (descended (d := d) f) n =
      𝓕 (fun x : (EuclideanSpace ℝ (Fin d)) => f x) (SchwartzMap.PoissonSummation.Standard.intVec (d := d) n) := by

  have hmeas :
      AEStronglyMeasurable
          (fun y : UnitAddTorus (Fin d) =>
            UnitAddTorus.mFourier (-n) y • (descended (d := d) f y))
          (volume : Measure (UnitAddTorus (Fin d))) :=
    ((UnitAddTorus.mFourier (-n)).continuous.smul (descended (d := d) f).continuous)
      |> fun h => h.aestronglyMeasurable
  have hpull :
      (∫ y : UnitAddTorus (Fin d),
            UnitAddTorus.mFourier (-n) y • (descended (d := d) f y)) =
        ∫ x in SchwartzMap.PoissonSummation.Standard.iocCube (d := d),
          UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) •
            (descended (d := d) f (PoissonSummation.Standard.coeFunE (d := d) x))
            ∂(volume : Measure (EuclideanSpace ℝ (Fin d))) := integral_eq_integral_preimage_coeFunE
              (fun y => (UnitAddTorus.mFourier (-n)) y • (descended f) y) hmeas

  have hsum_int :
      (∫ x in SchwartzMap.PoissonSummation.Standard.iocCube (d := d),
            UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) *
              (∑' ℓ : (SchwartzMap.standardLattice d), f (x + (ℓ : (EuclideanSpace ℝ (Fin d))))) ∂(volume : Measure (EuclideanSpace ℝ (Fin d)))) =
        ∑' ℓ : (SchwartzMap.standardLattice d),
          ∫ x in SchwartzMap.PoissonSummation.Standard.iocCube (d := d),
            UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) *
              f (x + (ℓ : (EuclideanSpace ℝ (Fin d)))) ∂(volume : Measure (EuclideanSpace ℝ (Fin d))) := by
    let s : Set (EuclideanSpace ℝ (Fin d)) := SchwartzMap.PoissonSummation.Standard.iocCube (d := d)
    have hInt :
        ∀ ℓ : (SchwartzMap.standardLattice d),
          Integrable
              (fun x : (EuclideanSpace ℝ (Fin d)) =>
                UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) *
                  f (x + (ℓ : (EuclideanSpace ℝ (Fin d)))))
              ((volume : Measure (EuclideanSpace ℝ (Fin d))).restrict s) := by
      intro ℓ
      simpa [IntegrableOn, s] using!
        (integrableOn_mFourier_mul_translate_iocCube (d := d) (f := f) n ℓ)
    have hSum :
        Summable (fun ℓ : (SchwartzMap.standardLattice d) =>
          ∫ x, ‖UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) *
                f (x + (ℓ : (EuclideanSpace ℝ (Fin d))))‖ ∂((volume : Measure (EuclideanSpace ℝ (Fin d))).restrict s)) := by

      simpa [s] using!
        (summable_integral_norm_mFourier_mul_translate_iocCube (d := d) (f := f) n)
    have :=
      (MeasureTheory.integral_tsum_of_summable_integral_norm
          (μ := (volume : Measure (EuclideanSpace ℝ (Fin d))).restrict s)
          (F := fun ℓ : (SchwartzMap.standardLattice d) =>
            fun x : (EuclideanSpace ℝ (Fin d)) =>
              UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) *
                f (x + (ℓ : (EuclideanSpace ℝ (Fin d)))))
          hInt hSum)

    simpa [s, tsum_mul_left, mul_assoc] using! this.symm


  have hFD :=
    (PoissonSummation.Standard.isAddFundamentalDomain_iocCube (d := d))
  have hint :
      Integrable
          (fun x : (EuclideanSpace ℝ (Fin d)) =>
            UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) * f x)
          (volume : Measure (EuclideanSpace ℝ (Fin d))) := by
    have hf : Integrable (fun x : (EuclideanSpace ℝ (Fin d)) => f x) (volume : Measure (EuclideanSpace ℝ (Fin d))) :=
      SchwartzMap.integrable (μ := (volume : Measure (EuclideanSpace ℝ (Fin d)))) f
    have hmeas :
        AEStronglyMeasurable
            (fun x : (EuclideanSpace ℝ (Fin d)) =>
              UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x))
            (volume : Measure (EuclideanSpace ℝ (Fin d))) :=
      ((UnitAddTorus.mFourier (-n)).continuous.comp
        (PoissonSummation.Standard.continuous_coeFunE (d := d))).aestronglyMeasurable
    have hbound :
        ∀ᵐ x : (EuclideanSpace ℝ (Fin d)) ∂(volume : Measure (EuclideanSpace ℝ (Fin d))),
          ‖UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x)‖ ≤ (1 : ℝ) :=
      ae_of_all _ fun x => by
        simpa [UnitAddTorus.mFourier_norm (d := Fin d) (n := -n)] using!
          (ContinuousMap.norm_coe_le_norm (UnitAddTorus.mFourier (-n))
            (PoissonSummation.Standard.coeFunE (d := d) x))
    simpa using! (Integrable.bdd_mul (μ := (volume : Measure (EuclideanSpace ℝ (Fin d)))) hf hmeas hbound)
  have hFD' :
      ∑' ℓ : (SchwartzMap.standardLattice d),
          ∫ x in SchwartzMap.PoissonSummation.Standard.iocCube (d := d),
            UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) *
              f (x + (ℓ : (EuclideanSpace ℝ (Fin d)))) ∂(volume : Measure (EuclideanSpace ℝ (Fin d))) =
        ∫ x : (EuclideanSpace ℝ (Fin d)),
          UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) * f x
            ∂(volume : Measure (EuclideanSpace ℝ (Fin d))) := by


    let g : (EuclideanSpace ℝ (Fin d)) → ℂ :=
      fun x : (EuclideanSpace ℝ (Fin d)) => UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) * f x
    have hmain :
        (∫ x : (EuclideanSpace ℝ (Fin d)), g x ∂(volume : Measure (EuclideanSpace ℝ (Fin d)))) =
          ∑' ℓ : (SchwartzMap.standardLattice d),
            ∫ x in SchwartzMap.PoissonSummation.Standard.iocCube (d := d), g (ℓ +ᵥ x)
              ∂(volume : Measure (EuclideanSpace ℝ (Fin d))) := by
      simpa [g] using!
        (MeasureTheory.IsAddFundamentalDomain.integral_eq_tsum'' (μ := (volume : Measure (EuclideanSpace ℝ (Fin d))))
          hFD (f := g) hint)

    have hterm :
        ∀ ℓ : (SchwartzMap.standardLattice d),
          (∫ x in SchwartzMap.PoissonSummation.Standard.iocCube (d := d), g (ℓ +ᵥ x)
              ∂(volume : Measure (EuclideanSpace ℝ (Fin d)))) =
            ∫ x in SchwartzMap.PoissonSummation.Standard.iocCube (d := d),
              UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) *
                f (x + (ℓ : (EuclideanSpace ℝ (Fin d)))) ∂(volume : Measure (EuclideanSpace ℝ (Fin d))) := by
      intro ℓ
      refine integral_congr_ae ?_
      refine ae_restrict_of_forall_mem
        (SchwartzMap.PoissonSummation.Standard.measurableSet_iocCube (d := d)) ?_
      intro x hx
      have hper' :
          UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) (x + (ℓ : (EuclideanSpace ℝ (Fin d))))) =
            UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) := by
        simpa using!
          (mFourier_neg_apply_coeFunE_add_standardLattice (d := d) (n := n) (ℓ := ℓ) (x := x))
      calc
        g (ℓ +ᵥ x) =
            UnitAddTorus.mFourier (-n)
                (PoissonSummation.Standard.coeFunE (d := d) ((ℓ : (EuclideanSpace ℝ (Fin d))) + x)) *
              f ((ℓ : (EuclideanSpace ℝ (Fin d))) + x) := by
          simp [g, Submodule.vadd_def, vadd_eq_add]
        _ =
            UnitAddTorus.mFourier (-n)
                (PoissonSummation.Standard.coeFunE (d := d) (x + (ℓ : (EuclideanSpace ℝ (Fin d))))) *
              f (x + (ℓ : (EuclideanSpace ℝ (Fin d)))) := by
          simp [add_comm]
        _ =
            UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) *
              f (x + (ℓ : (EuclideanSpace ℝ (Fin d)))) := by
          simp [hper']

    have hmain' := hmain.symm

    simpa [g, hterm] using! hmain'

  calc
    UnitAddTorus.mFourierCoeff (descended (d := d) f) n
        = ∫ y : UnitAddTorus (Fin d), UnitAddTorus.mFourier (-n) y • descended (d := d) f y := by




            simp only [UnitAddTorus.mFourierCoeff, smul_eq_mul]
            haveI : Fact (0 < (1 : ℝ)) := ⟨one_pos⟩
            have hμ_circle :
                (@volume UnitAddCircle instMeasureSpaceUnitAddCircle) =
                  (@volume UnitAddCircle (AddCircle.measureSpace (1 : ℝ))) := by
              change (AddCircle.haarAddCircle (T := (1 : ℝ)) : Measure UnitAddCircle) =
                (@volume UnitAddCircle (AddCircle.measureSpace (1 : ℝ)))
              simp [UnitAddCircle, AddCircle.volume_eq_smul_haarAddCircle]
            have hμ_torus :
                (@volume (UnitAddTorus (Fin d))
                    (@MeasureSpace.pi (Fin d) (Fin.fintype d) (fun _ => UnitAddCircle)
                      (fun _ => instMeasureSpaceUnitAddCircle))) =
                  (@volume (UnitAddTorus (Fin d))
                    (@MeasureSpace.pi (Fin d) (Fin.fintype d) (fun _ => UnitAddCircle)
                      (fun _ => AddCircle.measureSpace (1 : ℝ)))) := by

              change
                Measure.pi (fun _ : Fin d => @volume UnitAddCircle instMeasureSpaceUnitAddCircle) =
                  Measure.pi
                    (fun _ : Fin d =>
                      @volume UnitAddCircle (AddCircle.measureSpace (1 : ℝ)))
              exact congrArg Measure.pi (funext fun _ => hμ_circle)

            simp [hμ_torus]
    _ = ∫ x in SchwartzMap.PoissonSummation.Standard.iocCube (d := d),
          UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) •
            descended (d := d) f (PoissonSummation.Standard.coeFunE (d := d) x)
            ∂(volume : Measure (EuclideanSpace ℝ (Fin d))) := by
          simpa using! hpull
    _ = ∫ x in SchwartzMap.PoissonSummation.Standard.iocCube (d := d),
          UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) *
            (∑' ℓ : (SchwartzMap.standardLattice d), f (x + (ℓ : (EuclideanSpace ℝ (Fin d))))) ∂(volume : Measure (EuclideanSpace ℝ (Fin d))) := by

          refine integral_congr_ae ?_
          refine ae_restrict_of_forall_mem
            (SchwartzMap.PoissonSummation.Standard.measurableSet_iocCube (d := d)) ?_
          intro x hx
          simp [descended_comp (d := d) (f := f), periodized_apply (d := d) (f := f),
            smul_eq_mul]
    _ = ∑' ℓ : (SchwartzMap.standardLattice d),
          ∫ x in SchwartzMap.PoissonSummation.Standard.iocCube (d := d),
            UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) *
              f (x + (ℓ : (EuclideanSpace ℝ (Fin d)))) ∂(volume : Measure (EuclideanSpace ℝ (Fin d))) := by
          simpa using! hsum_int
    _ = ∫ x : (EuclideanSpace ℝ (Fin d)),
          UnitAddTorus.mFourier (-n) (PoissonSummation.Standard.coeFunE (d := d) x) * f x
            ∂(volume : Measure (EuclideanSpace ℝ (Fin d))) := by
          simpa using! hFD'
    _ = 𝓕 (fun x : (EuclideanSpace ℝ (Fin d)) => f x) (SchwartzMap.PoissonSummation.Standard.intVec (d := d) n) := by

          simp [Real.fourier_eq, Circle.smul_def, smul_eq_mul,
            mFourier_neg_apply_coeFunE (d := d) (n := n)]

lemma summable_mFourierCoeff_descended :
    Summable (UnitAddTorus.mFourierCoeff (descended (d := d) f)) := by

  have hsum_norm :
      Summable (fun n : Fin d → ℤ =>
        ‖𝓕 (fun x : (EuclideanSpace ℝ (Fin d)) => f x) (SchwartzMap.PoissonSummation.Standard.intVec (d := d) n)‖) := by

    let k : ℕ := d + 1
    have hk : Module.finrank ℤ (SchwartzMap.standardLattice d) < k := by
      have hrank : Module.finrank ℤ (SchwartzMap.standardLattice d) = d := by
        have h := (ZLattice.rank (K := ℝ) (L := (SchwartzMap.standardLattice d)))
        simpa using! (h.trans (by simp))
      simp [hrank, k]

    obtain ⟨C, hCpos, hC⟩ := (FourierTransform.fourierCLE ℂ (SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ) f).decay k 0
    have hC' : ∀ x : (EuclideanSpace ℝ (Fin d)), ‖x‖ ^ k * ‖𝓕 (fun y : (EuclideanSpace ℝ (Fin d)) => f y) x‖ ≤ C := by
      simpa [FourierTransform.fourierCLE_apply, fourier_coe, norm_iteratedFDeriv_zero] using! hC
    have hsum_pow :
        Summable (fun ℓ : (SchwartzMap.standardLattice d) => (‖(ℓ : (EuclideanSpace ℝ (Fin d)))‖⁻¹ ^ k : ℝ)) := by
      simpa [k] using! (ZLattice.summable_norm_pow_inv (L := (SchwartzMap.standardLattice d)) (n := k) hk)
    have hsum_bd : Summable (fun ℓ : (SchwartzMap.standardLattice d) => (C : ℝ) * (‖(ℓ : (EuclideanSpace ℝ (Fin d)))‖⁻¹ ^ k)) :=
      hsum_pow.mul_left C
    have hsum_lattice : Summable (fun ℓ : (SchwartzMap.standardLattice d) => ‖𝓕 (fun y : (EuclideanSpace ℝ (Fin d)) => f y) (ℓ : (EuclideanSpace ℝ (Fin d)))‖) := by

      have hfin : ({ℓ : (SchwartzMap.standardLattice d) | ‖(ℓ : (EuclideanSpace ℝ (Fin d)))‖ ≤ (1 : ℝ)} : Set _).Finite :=
        finite_norm_le_lattice (d := d) 1
      refine Summable.of_norm_bounded_eventually hsum_bd ?_
      filter_upwards [hfin.compl_mem_cofinite] with ℓ hℓ
      have hnorm_gt : (1 : ℝ) < ‖(ℓ : (EuclideanSpace ℝ (Fin d)))‖ := lt_of_not_ge (by simpa using! hℓ)
      have hnorm_pos : 0 < ‖(ℓ : (EuclideanSpace ℝ (Fin d)))‖ := lt_trans (by positivity) hnorm_gt
      have hpow_pos : 0 < ‖(ℓ : (EuclideanSpace ℝ (Fin d)))‖ ^ k := pow_pos hnorm_pos _
      have hmain := hC' (ℓ : (EuclideanSpace ℝ (Fin d)))
      have : ‖𝓕 (fun y : (EuclideanSpace ℝ (Fin d)) => f y) (ℓ : (EuclideanSpace ℝ (Fin d)))‖ ≤ C / (‖(ℓ : (EuclideanSpace ℝ (Fin d)))‖ ^ k) :=
        (le_div_iff₀' hpow_pos).2 hmain
      have hdiv :
          ‖𝓕 (fun y : (EuclideanSpace ℝ (Fin d)) => f y) (ℓ : (EuclideanSpace ℝ (Fin d)))‖ ≤ (C : ℝ) * (‖(ℓ : (EuclideanSpace ℝ (Fin d)))‖⁻¹ ^ k) := by
        simpa [div_eq_mul_inv, inv_pow, one_div] using! this

      simpa [Real.norm_of_nonneg (norm_nonneg _)] using! hdiv

    let e := (PoissonSummation.Standard.equivIntVec (d := d))
    have : Summable (fun n : Fin d → ℤ => ‖𝓕 (fun y : (EuclideanSpace ℝ (Fin d)) => f y) ((e n : (SchwartzMap.standardLattice d)) : (EuclideanSpace ℝ (Fin d)))‖) := by
      simpa using! (Summable.comp_injective hsum_lattice e.injective)
    simpa [PoissonSummation.Standard.equivIntVec] using! this

  refine (Summable.of_norm ?_)
  simpa [mFourierCoeff_descended (d := d) (f := f)] using! hsum_norm


theorem poissonSummation_standard (v : (EuclideanSpace ℝ (Fin d))) :
    (∑' ℓ : (SchwartzMap.standardLattice d), f (v + (ℓ : (EuclideanSpace ℝ (Fin d))))) =
      ∑' n : Fin d → ℤ,
        (𝓕 (fun x : (EuclideanSpace ℝ (Fin d)) => f x) (SchwartzMap.PoissonSummation.Standard.intVec (d := d) n)) *
          Complex.exp
            (2 * Real.pi * Complex.I *
              ⟪v, SchwartzMap.PoissonSummation.Standard.intVec (d := d) n⟫_[ℝ]) := by
  simpa [descended_comp (d := d) (f := f) v, periodized_apply (d := d) (f := f), smul_eq_mul,
    mFourierCoeff_descended (d := d) (f := f), mFourier_apply_coeFunE_exp (d := d), mul_assoc,
    mul_left_comm, mul_comm] using!
    (UnitAddTorus.hasSum_mFourier_series_apply_of_summable
        (f := descended (d := d) f)
        (summable_mFourierCoeff_descended (d := d) (f := f))
        (coeFunE (d := d) v)).tsum_eq.symm

end SchwartzMap.PoissonSummation.Standard

