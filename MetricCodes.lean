      _ = Cneg *
          (Real.exp ((-a) * |y|) *
            |lowerGammaBoundaryLog ℓ R y|) := by
        rw [abs_of_neg (mem_Iio.mp hy), hnegfactor]
        simp [mul_neg, neg_mul]
        ring
  rw [← integrableOn_univ, ← @Iio_union_Ici _ _ (0 : ℝ),
    integrableOn_union, integrableOn_Ici_iff_integrableOn_Ioi]
  exact ⟨hleft, hright⟩






