      0 ≤ betaPDFReal (1 / 2 : ℝ) (1 / 2 : ℝ) u := by
    by_cases hu : 0 < u ∧ u < 1
    · exact (betaPDFReal_pos hu.1 hu.2 (by norm_num) (by norm_num)).le
    · simp [betaPDFReal, hu]
