      ‖1 - 3 * Complex.I * z‖ ≤
        3 * (1 + |u|) ^ 2 := by
    simpa [hz] using! minusSaddleQuadraticCoefficient_norm_le z
  have hidentity :
      minusPolynomial ε ((T : ℂ) + z) -
          minusPolynomial ε z =
        (T : ℂ) * (2 * z - Complex.I * (1 + 3 * z ^ 2)) +
