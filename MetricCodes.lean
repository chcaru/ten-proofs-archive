  have hhalf : ∀ n : ℕ, z / 2 ≠ -(n : ℂ) := by
    intro n hzero
    apply hz n
    push_cast at hzero ⊢
    linear_combination 2 * hzero
  exact (Complex.differentiableAt_Gamma (z / 2)
    hhalf).comp z (by fun_prop)



