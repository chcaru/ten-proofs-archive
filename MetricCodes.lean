theorem plusSaddleMellinData_fourier_vertical (ε ℓ y : ℝ) :
    plusSaddleMellinData ε ℓ
      ((ℓ : ℂ) + (2 * Real.pi * y : ℝ) * Complex.I) =
        plusSaddleFourierData ε ℓ y := by
  have harg :
      ((ℓ : ℂ) + (2 * Real.pi * y : ℝ) * Complex.I) =
        ((ℓ : ℂ) - Complex.I *
          ((-(2 * Real.pi * y) : ℝ) : ℂ)) := by
    push_cast
    ring
  rw [harg, plusSaddleMellinData_vertical]
  rfl



