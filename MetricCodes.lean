theorem harmonic_bottom_normalized_height_tendsto
    {ℓ : ℝ} (hℓ : 0 < ℓ) (s : ℝ) :
    Tendsto
      (fun z : ℂ => z.im / ℓ)
      (𝓝[Complex.im ⁻¹' Ioo (-ℓ) ℓ]
