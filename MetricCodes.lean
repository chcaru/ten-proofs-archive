      have : ‖f (a + (ℓ : EuclideanSpace ℝ (Fin d)))‖ ≤
          (C + 1) * ‖(ℓ : EuclideanSpace ℝ (Fin d)) - b‖⁻¹ ^ k := by
        simpa [div_eq_mul_inv, inv_pow] using! (hle.trans (by simpa using! hmono))
      simpa using! this
    trivial

