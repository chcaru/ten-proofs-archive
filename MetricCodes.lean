      rw [← Real.exp_add]
      congr 1
      try dsimp [a]
      ring
    rw [hsplit]
    try dsimp [Cpos]
    ring
  have hnegfactor (y : ℝ) :
      Real.exp (-(Real.pi * (z.re - y) / (2 * ℓ))) / D =
        Cneg * Real.exp (a * y) := by
    have hsplit :
        Real.exp (-(Real.pi * (z.re - y) / (2 * ℓ))) =
          Real.exp (-a * z.re) * Real.exp (a * y) := by
      rw [← Real.exp_add]
