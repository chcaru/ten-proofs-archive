theorem exists_plusPolynomial_uniform_weighted_bound
    {ε : ℝ} (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧
      ∀ u : ℝ, -1 ≤ u → ∀ T : ℝ,
        ‖plusPolynomial ε
          ((T : ℂ) + Complex.I * (u : ℂ))‖ ≤
          C * (1 + |T| ^ 3) *
            ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_plusPolynomial_uniform_norm_ratio hε
  refine ⟨C, hC, ?_⟩
  intro u hu T
  have hden : 0 <
      ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ :=
    (beta_pos hε).trans_le
      (plusPolynomial_imaginary_norm_ge_beta hε hu)
  exact (div_le_iff₀ hden).mp (hbound u hu T)



theorem exists_minusPolynomial_uniform_weighted_bound
    {ε : ℝ} (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧
      ∀ u : ℝ, 1 + ε / 4 ≤ u → ∀ T : ℝ,
        ‖minusPolynomial ε
          ((T : ℂ) + Complex.I * (u : ℂ))‖ ≤
          C * (1 + |T| ^ 3) *
            ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_minusPolynomial_uniform_norm_ratio hε
  refine ⟨C, hC, ?_⟩
  intro u hu T
  have hden : 0 <
      ‖minusPolynomial ε (Complex.I * (u : ℂ))‖ := by
    have hbeta := beta_pos hε
    have hnorm :=
      minusPolynomial_imaginary_norm_ge_three_beta hε hu
    nlinarith
  exact (div_le_iff₀ hden).mp (hbound u hu T)




theorem exists_plusPolynomial_uniform_difference_bound
    {ε : ℝ} (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧
      ∀ u : ℝ, -1 ≤ u → ∀ T : ℝ,
        ‖plusPolynomial ε
            ((T : ℂ) + Complex.I * (u : ℂ)) -
          plusPolynomial ε (Complex.I * (u : ℂ))‖ ≤
          C * (|T| + |T| ^ 3) *
            ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_plusPolynomial_uniform_difference_ratio hε
  refine ⟨C, hC, ?_⟩
  intro u hu T
  have hden : 0 <
      ‖plusPolynomial ε (Complex.I * (u : ℂ))‖ :=
    (beta_pos hε).trans_le
      (plusPolynomial_imaginary_norm_ge_beta hε hu)
  exact (div_le_iff₀ hden).mp (hbound u hu T)



theorem exists_minusPolynomial_uniform_difference_bound
    {ε : ℝ} (hε : 0 < ε) :
