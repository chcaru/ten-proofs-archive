        (((a : ℂ) + (t : ℂ) * Complex.I) -
          (ℓ : ℂ)) / (ℓ : ℂ)‖) ^ 3 :=
      norm_minusPolynomial_le ε _
    _ ≤ (1 + |beta ε|) *
      ((1 + ℓ⁻¹ + |(a - ℓ) / ℓ|) * |t|) ^ 3 := by
      gcongr
