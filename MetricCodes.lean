  simpa using! hscaled.rexp




theorem tendsto_upperShellMarginRatio :
    Tendsto upperShellMarginRatio
      (𝓝[>] (0 : ℝ)) (𝓝 (0 : ℝ)) := by
  apply tendsto_nhdsGT_zero_of_comp_inv_tendsto_atTop
  have hproduct :
