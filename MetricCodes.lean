    change 0 < ((d : ℝ) / 2) * (1 + u) / 2
    positivity
  have hdigamma :
      ContinuousOn (fun u => saddleDigamma (g u)) (Ici u₀) :=
    saddleDigamma_continuousOn_Ioi.comp
