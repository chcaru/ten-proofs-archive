  apply saddleHorizontalIntegral_tendsto_zero
    (F := fun z : ℂ =>
      saddleMellinInversePower r z *
        plusSaddleMellinData ε ℓ z)
    hAB (C := C) ?_ s hs
  simpa using! hbound



