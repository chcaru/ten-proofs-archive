    eventually_gt_atTop (0 : ℕ)] with d hfirst_d hsecond_d hd
  intro r hr
  obtain ⟨u, hu, hlog⟩ := hcoverage d hd r hr
  have hrpos : 0 < r :=
    (saddleSourceRadius_pos ε d).trans_le hr
  have hexp : Real.exp (saddleLogRadius ε d u) = r := by
    rw [hlog, Real.exp_log hrpos]
