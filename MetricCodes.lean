def wallisRadiusIntegrand (a : ℝ) : ℝ :=
  -(Real.exp (-2 * a) * Real.tanh a / (2 * a))




theorem tendsto_shortShellRadiusIntegrand {a : ℝ} (ha : 0 < a) :
    Tendsto (fun ε : ℝ => shortShellRadiusIntegrand ε a)
