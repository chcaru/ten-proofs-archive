            (-Complex.I) * (T : ℂ) ^ 3 := by
    rw [add_comm (T : ℂ) z,
      minusPolynomial_add_sub]
    ring
  change
    ‖minusPolynomial ε ((T : ℂ) + z) -
        minusPolynomial ε z‖ ≤ _
  rw [hidentity]
  exact saddle_cubic_translation_norm_le u T
    (2 * z - Complex.I * (1 + 3 * z ^ 2))
    (1 - 3 * Complex.I * z) (-Complex.I)
    hA hB (by simp)



