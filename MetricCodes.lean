  intro z
  rw [show plusSaddleMellinData ε ℓ =
      (fun w : ℂ => Complex.Gamma (w / 2) *
        plusSaddleRegularMellinFactor ε ℓ w) by
    funext w
    exact plusSaddleMellinData_eq_gamma_mul_regular ε ℓ w]
