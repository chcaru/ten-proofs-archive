        (clebschNormSq w (n - w) p q t /
          clebschNormSq w (n - w) p q (t + 1)) := by
  have hn : 0 < n := by omega
  have haxis :
      0 ≤ (n : ℝ) / ((w : ℝ) * ((n - w : ℕ) : ℝ)) := by
    have hw' : 0 < (w : ℝ) := by exact_mod_cast hw
