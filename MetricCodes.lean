theorem johnsonMiddleChannel_orthogonal_upperChannel {n j : ℕ}
    (f g : MetricCodes.Boolean.Function n)
    (hf : MetricCodes.Boolean.IsHarmonic (j + 1) f)
    (hg : MetricCodes.Boolean.IsHarmonic j g)
    (hhalf : 2 * (j + 1) < n) :
