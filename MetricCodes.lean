theorem eventually_plusSaddleSmallRadius_relativeFiniteResidue_lt_half_on_star
    {ε : ℝ}
    (hε : 0 < ε)
    (horder : shortCutoff ε ≤ shortEndpoint ε) :
    ∀ᶠ d : ℕ in atTop,
      ∀ r : ℝ,
