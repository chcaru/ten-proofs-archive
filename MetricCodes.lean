      (∫ u in (0 : ℝ)..1, g (2 * u - 1) * 2) =
        ∫ z in (-1 : ℝ)..1, g z := by
    convert intervalIntegral.integral_comp_mul_deriv_of_deriv_nonneg
      (a := (0 : ℝ)) (b := 1)
      (f := fun u : ℝ => 2 * u - 1) (f' := fun _ : ℝ => 2)
      (g := g)
      (by fun_prop)
      (fun u _ => by
        simpa using
          (((hasDerivAt_const (x := u) (c := (2 : ℝ))).mul
            (hasDerivAt_id u)).sub_const 1))
